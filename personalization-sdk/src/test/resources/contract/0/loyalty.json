{
  "contract": "0",
  "cases": [
    {
      "name": "join со всеми полями",
      "call": { "namespace": "loyalty", "method": "join",
                "args": { "phone": "+79991234567", "firstName": "Anna", "lastName": "Ivanova", "gender": "female", "birthday": "1990-05-17" } },
      "request": { "method": "POST", "path": "loyalty/members/join",
                   "body": { "phone": "+79991234567", "first_name": "Anna", "last_name": "Ivanova", "gender": "f", "birthday": "1990-05-17" } }
    },
    {
      "name": "join с телефоном и полом: телефон уходит как есть",
      "call": { "namespace": "loyalty", "method": "join", "args": { "phone": "89991234567", "gender": "male" } },
      "request": { "method": "POST", "path": "loyalty/members/join", "body": { "phone": "89991234567", "gender": "m" } }
    },
    {
      "name": "join с пустым phone",
      "call": { "namespace": "loyalty", "method": "join", "args": { "phone": "" } },
      "error": { "type": "invalidArgument" }
    },
    {
      "name": "join с birthday не YYYY-MM-DD",
      "call": { "namespace": "loyalty", "method": "join", "args": { "phone": "+79991234567", "birthday": "17.05.1990" } },
      "error": { "type": "invalidArgument" }
    },
    {
      "name": "join: birthday — несуществующая дата; непонятную дату сервер стёр бы",
      "call": { "namespace": "loyalty", "method": "join", "args": { "phone": "+79991234567", "birthday": "1990-02-30" } },
      "error": { "type": "invalidArgument" }
    },
    {
      "name": "join: пустой birthday",
      "call": { "namespace": "loyalty", "method": "join", "args": { "phone": "+79991234567", "birthday": "" } },
      "error": { "type": "invalidArgument" }
    },
    {
      "name": "join — новый участник",
      "call": { "namespace": "loyalty", "method": "join", "args": { "phone": "+79991234567" } },
      "response": { "status": 200,
                    "body": { "status": "success", "payload": { "message": "Member is registered successfully", "identifier": "79991234567" } } },
      "expect": { "result": { "identifier": "79991234567" } }
    },
    {
      "name": "join — телефон уже зарегистрирован, тот же идентификатор (В45)",
      "call": { "namespace": "loyalty", "method": "join", "args": { "phone": "+79991234567" } },
      "response": { "status": 200,
                    "body": { "status": "success", "payload": { "message": "Member is already registered", "identifier": 79991234567 } } },
      "expect": { "result": { "identifier": "79991234567" } }
    },
    {
      "name": "join — 403, у магазина выключены методы лояльности с фронта (В17, В18)",
      "call": { "namespace": "loyalty", "method": "join", "args": { "phone": "+79991234567" } },
      "response": { "status": 403, "body": { "status": "error", "message": "Shop not found by secret key" } },
      "expect": { "error": { "type": "http", "code": 403 } }
    },
    {
      "name": "join — ответ без identifier",
      "call": { "namespace": "loyalty", "method": "join", "args": { "phone": "+79991234567" } },
      "response": { "status": 200, "body": { "status": "success", "payload": { "message": "Member is registered successfully" } } },
      "expect": { "error": { "type": "decoding" } }
    },
    {
      "name": "getStatus",
      "call": { "namespace": "loyalty", "method": "getStatus", "args": { "phone": "+79991234567" } },
      "request": { "method": "GET", "path": "loyalty/members/status", "query": { "identifier": "+79991234567" } }
    },
    {
      "name": "getStatus с пустым phone",
      "call": { "namespace": "loyalty", "method": "getStatus", "args": { "phone": "" } },
      "error": { "type": "invalidArgument" }
    },
    {
      "name": "getStatus — участник на уровне",
      "call": { "namespace": "loyalty", "method": "getStatus", "args": { "phone": "+79991234567" } },
      "response": { "status": 200,
                    "body": { "status": "success",
                              "payload": { "member": true, "level": { "name": "Gold", "code": "level_gold", "expiration_date": "2028-01-01" } } } },
      "expect": { "result": { "isMember": true, "level": { "code": "level_gold", "name": "Gold", "expirationDate": "2028-01-01" } } }
    },
    {
      "name": "getStatus — базовый уровень: level пусто",
      "call": { "namespace": "loyalty", "method": "getStatus", "args": { "phone": "+79991234567" } },
      "response": { "status": 200,
                    "body": { "status": "success",
                              "payload": { "member": true, "level": { "name": null, "code": null, "expiration_date": null } } } },
      "expect": { "result": { "isMember": true, "level": null } }
    },
    {
      "name": "getStatus — не участник",
      "call": { "namespace": "loyalty", "method": "getStatus", "args": { "phone": "+79991234567" } },
      "response": { "status": 200,
                    "body": { "status": "success",
                              "payload": { "member": false, "level": { "name": null, "code": null, "expiration_date": null } } } },
      "expect": { "result": { "isMember": false, "level": null } }
    },
    {
      "name": "getStatus — 400, неверный идентификатор",
      "call": { "namespace": "loyalty", "method": "getStatus", "args": { "phone": "12" } },
      "response": { "status": 400, "body": { "status": "error", "message": "Incorrect member identifier" } },
      "expect": { "error": { "type": "http", "code": 400 } }
    },
    {
      "name": "getStatus — 404, лояльность не настроена",
      "call": { "namespace": "loyalty", "method": "getStatus", "args": { "phone": "+79991234567" } },
      "response": { "status": 404, "body": { "status": "error", "message": "Loyalty program not found" } },
      "expect": { "error": { "type": "http", "code": 404 } }
    },
    {
      "name": "getPromotions без параметров",
      "call": { "namespace": "loyalty", "method": "getPromotions", "args": {} },
      "request": { "method": "GET", "path": "loyalty/promos/for-client", "query": {} }
    },
    {
      "name": "getPromotions со всеми параметрами: промокоды — массивом Rails",
      "call": { "namespace": "loyalty", "method": "getPromotions",
                "args": { "locationId": "msk-1", "promoCodes": [ "SPRING", "VIP" ], "chargeBonuses": true, "currentTime": "18:30" } },
      "request": { "method": "GET", "path": "loyalty/promos/for-client",
                   "query": { "location_id": "msk-1", "promo_codes[]": [ "SPRING", "VIP" ], "charge_bonuses": "true", "current_time": "18:30" } }
    },
    {
      "name": "getPromotions с currentTime не HH:MM",
      "call": { "namespace": "loyalty", "method": "getPromotions", "args": { "currentTime": "25:00" } },
      "error": { "type": "invalidArgument" }
    },
    {
      "name": "getPromotions с пустым промокодом",
      "call": { "namespace": "loyalty", "method": "getPromotions", "args": { "promoCodes": [ "SPRING", "" ] } },
      "error": { "type": "invalidArgument" }
    },
    {
      "name": "getPromotions — акции из документации; id больше 2^31",
      "call": { "namespace": "loyalty", "method": "getPromotions", "args": {} },
      "response": { "status": 200,
                    "body": { "status": "success",
                              "payload": { "promotions": [
                                { "id": 33, "name": "Half price", "start_date": "2026-01-01", "finish_date": "2026-01-14", "stream": "ios",
                                  "badge_label": "-50%", "badge_color": "#AABB00", "description": "On one product",
                                  "reward_type": "discount",
                                  "reward_rules": { "amount_type": "percentage", "reward_type": "discount", "amount_value": 100,
                                                    "include_products": [ { "sku": { "values": "300275", "operator": "in" } } ] } },
                                { "id": 3000000012, "name": "1+1=3", "start_date": "2026-01-01", "finish_date": "2026-01-14", "stream": null,
                                  "badge_label": "1+1=3", "badge_color": "#AA0000", "description": null,
                                  "reward_type": "bonuses_earn", "reward_rules": {} },
                                { "id": "7", "name": "Spend bonuses", "reward_type": "bonuses_usage" } ] } } },
      "expect": { "result": [
        { "id": 33, "name": "Half price", "description": "On one product", "startDate": "2026-01-01", "finishDate": "2026-01-14",
          "stream": "ios", "badgeLabel": "-50%", "badgeColor": "#AABB00", "rewardType": "discount" },
        { "id": 3000000012, "name": "1+1=3", "description": null, "stream": null, "badgeLabel": "1+1=3", "rewardType": "bonusesEarn" },
        { "id": 7, "name": "Spend bonuses", "startDate": null, "finishDate": null, "badgeColor": null, "rewardType": "bonusesUsage" } ] }
    },
    {
      "name": "getPromotions — незнакомый reward_type даёт пустое поле",
      "call": { "namespace": "loyalty", "method": "getPromotions", "args": {} },
      "response": { "status": 200,
                    "body": { "status": "success", "payload": { "promotions": [ { "id": 5, "name": "Gift", "reward_type": "gift" } ] } } },
      "expect": { "result": [ { "id": 5, "name": "Gift", "rewardType": null } ] }
    },
    {
      "name": "getPromotions — нет подходящих акций",
      "call": { "namespace": "loyalty", "method": "getPromotions", "args": {} },
      "response": { "status": 200, "body": { "status": "success", "payload": { "promotions": [] } } },
      "expect": { "result": [] }
    },
    {
      "name": "getPromotions — 402, услуга лояльности выключена",
      "call": { "namespace": "loyalty", "method": "getPromotions", "args": {} },
      "response": { "status": 402, "body": { "status": "error", "message": "Loyalty service is disabled" } },
      "expect": { "error": { "type": "http", "code": 402 } }
    },
    {
      "name": "2xx со status error",
      "call": { "namespace": "loyalty", "method": "getPromotions", "args": {} },
      "response": { "status": 200, "body": { "status": "error", "message": "Something went wrong" } },
      "expect": { "error": { "type": "decoding" } }
    },
    {
      "name": "нет ответа",
      "call": { "namespace": "loyalty", "method": "getStatus", "args": { "phone": "+79991234567" } },
      "response": { "status": null },
      "expect": { "error": { "type": "network" } }
    }
  ]
}
