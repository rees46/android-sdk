      "expect": { "result": [ { "id": "37", "name": "Кроссовки", "url": "https://shop.example/p/37", "price": 4990, "currency": "₽",
                                "oldPrice": 5990, "isNew": true, "stockQuantity": 1000, "rating": 4,
                                "categories": [ { "id": "5", "name": "Обувь", "url": "https://shop.example/c/5" } ] } ] }
    },
    {
      "name": "getLastOrder: заказов нет",
      "call": { "namespace": "profile", "method": "getLastOrder", "args": {} },
