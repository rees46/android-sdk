{
  "contract": "0",
  "cases": [
    {
      "name": "get",
      "call": { "namespace": "profile", "method": "get", "args": {} },
      "request": { "method": "GET", "path": "profile", "query": {} }
    },
    {
      "name": "set со всеми полями: externalId уходит полями id и external_id, cars — полем auto, свои свойства — на верхнем уровне",
      "call": { "namespace": "profile", "method": "set",
                "args": { "request": { "email": "jane@example.com", "phone": "+79990000000", "externalId": "u-1", "loyaltyId": "l-1",
                                       "telegramId": "t-1", "fbId": "fb-1", "vkId": "vk-1", "firstName": "Jane", "lastName": "Doe",
                                       "gender": "female", "birthday": "1990-02-28", "age": 36, "location": "msk",
                                       "kids": [ { "gender": "male", "birthday": "2016-02-29" }, { "gender": "female" } ],
                                       "cars": [ { "brand": "Lada", "model": "Vesta", "vds": "XTA000000000" } ],
                                       "customProperties": { "favorite_color": "green", "points": 120, "vip": true, "visited_at": null,
                                                             "tags": [ "a", "b" ], "address": { "city": "Moscow" } } } } },
      "request": { "method": "POST", "path": "profile/set",
                   "body": { "email": "jane@example.com", "phone": "+79990000000", "id": "u-1", "external_id": "u-1", "loyalty_id": "l-1",
                             "telegram_id": "t-1", "fb_id": "fb-1", "vk_id": "vk-1", "first_name": "Jane", "last_name": "Doe",
                             "gender": "f", "birthday": "1990-02-28", "age": 36, "location": "msk",
                             "kids": [ { "gender": "m", "birthday": "2016-02-29" }, { "gender": "f" } ],
                             "auto": [ { "brand": "Lada", "model": "Vesta", "vds": "XTA000000000" } ],
                             "favorite_color": "green", "points": 120, "vip": true, "visited_at": null,
                             "tags": [ "a", "b" ], "address": { "city": "Moscow" } } }
    },
    {
      "name": "set: пустая строка стирает location",
      "call": { "namespace": "profile", "method": "set", "args": { "request": { "location": "" } } },
      "request": { "method": "POST", "path": "profile/set", "body": { "location": "" } }
    },
    {
      "name": "set: пустые списки не уходят — менять нечего",
      "call": { "namespace": "profile", "method": "set", "args": { "request": { "kids": [], "cars": [] } } },
      "error": { "type": "invalidArgument" }
    },
    {
      "name": "set без полей",
      "call": { "namespace": "profile", "method": "set", "args": { "request": {} } },
      "error": { "type": "invalidArgument" }
    },
    {
      "name": "set с пустым email",
      "call": { "namespace": "profile", "method": "set", "args": { "request": { "email": "" } } },
      "error": { "type": "invalidArgument" }
    },
    {
      "name": "set с пустым phone",
      "call": { "namespace": "profile", "method": "set", "args": { "request": { "phone": "" } } },
      "error": { "type": "invalidArgument" }
    },
    {
      "name": "set с пустым loyaltyId — сервер его не стирает",
      "call": { "namespace": "profile", "method": "set", "args": { "request": { "loyaltyId": "" } } },
      "error": { "type": "invalidArgument" }
    },
    {
      "name": "set: пустая строка стирает externalId, telegramId и birthday — они уходят пустыми строками",
      "call": { "namespace": "profile", "method": "set", "args": { "request": { "externalId": "", "telegramId": "", "birthday": "" } } },
      "request": { "method": "POST", "path": "profile/set", "body": { "id": "", "external_id": "", "telegram_id": "", "birthday": "" } }
    },
    {
      "name": "set: age 0 стирает возраст",
      "call": { "namespace": "profile", "method": "set", "args": { "request": { "age": 0 } } },
      "request": { "method": "POST", "path": "profile/set", "body": { "age": 0 } }
    },
    {
      "name": "set: birthday не в формате YYYY-MM-DD",
      "call": { "namespace": "profile", "method": "set", "args": { "request": { "birthday": "28.02.1990" } } },
      "error": { "type": "invalidArgument" }
    },
    {
      "name": "set: birthday — несуществующая дата",
      "call": { "namespace": "profile", "method": "set", "args": { "request": { "birthday": "2026-02-29" } } },
      "error": { "type": "invalidArgument" }
    },
