                              "custom_properties": { "favorite_color": "green", "points": 120, "tags": [ "a", "b" ], "address": { "city": "Moscow" } } } },
      "expect": { "result": { "id": "123", "hasEmail": true, "emailRegisteredAt": "2026-11-01 10:00:00", "gender": "female",
                              "boughtSomething": false,
                              "customProperties": { "favorite_color": "green", "points": 120, "tags": [ "a", "b" ], "address": { "city": "Moscow" } } } }
    },
    {
      "name": "get: пустой профиль",
      "call": { "namespace": "profile", "method": "get", "args": {} },
      "response": { "status": 200, "body": {} },
      "expect": { "result": {} }
    },
    {
      "name": "get: 404 — неизвестный did",
      "call": { "namespace": "profile", "method": "get", "args": {} },
      "response": { "status": 404, "body": { "status": "error", "message": "Client not found" } },
      "expect": { "error": { "type": "http", "code": 404 } }
    },
    {
      "name": "get: ответ не объект",
      "call": { "namespace": "profile", "method": "get", "args": {} },
      "response": { "status": 200, "body": [] },
      "expect": { "error": { "type": "decoding" } }
    },
    {
      "name": "set: успех",
      "call": { "namespace": "profile", "method": "set", "args": { "request": { "email": "jane@example.com" } } },
      "response": { "status": 200, "body": { "status": "success" } },
      "expect": { "result": null }
    },
    {
      "name": "set: успех без тела",
      "call": { "namespace": "profile", "method": "set", "args": { "request": { "email": "jane@example.com" } } },
      "response": { "status": 204, "body": null },
      "expect": { "result": null }
    },
    {
      "name": "set: 400 — сервер не принял email",
      "call": { "namespace": "profile", "method": "set", "args": { "request": { "email": "not-an-email" } } },
      "response": { "status": 400, "body": { "status": "error", "message": "Invalid email" } },
      "expect": { "error": { "type": "http", "code": 400 } }
    },
    {
      "name": "set: 2xx со status error",
      "call": { "namespace": "profile", "method": "set", "args": { "request": { "email": "jane@example.com" } } },
      "response": { "status": 200, "body": { "status": "error", "message": "Something went wrong" } },
      "expect": { "error": { "type": "decoding" } }
    },
    {
      "name": "set: нет ответа",
      "call": { "namespace": "profile", "method": "set", "args": { "request": { "email": "jane@example.com" } } },
      "response": { "status": null },
      "expect": { "error": { "type": "network" } }
    },
    {
      "name": "getLastOrder: товары последнего заказа",
      "call": { "namespace": "profile", "method": "getLastOrder", "args": {} },
      "response": { "status": 200,
                    "body": [ { "id": "37", "name": "Кроссовки", "url": "https://shop.example/p/37", "price": 4990, "currency": "₽",
