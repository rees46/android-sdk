      "call": { "namespace": "profile", "method": "set", "args": { "request": { "kids": [ { "birthday": "2015-02-29" } ] } } },
      "error": { "type": "invalidArgument" }
    },
    {
      "name": "set: birthday ребёнка не в формате",
      "call": { "namespace": "profile", "method": "set", "args": { "request": { "kids": [ { "birthday": "2016-2-1" } ] } } },
      "error": { "type": "invalidArgument" }
    },
    {
      "name": "set: отрицательный age",
      "call": { "namespace": "profile", "method": "set", "args": { "request": { "age": -1 } } },
      "error": { "type": "invalidArgument" }
    },
    {
      "name": "set: ключ customProperties не из [a-z0-9_]",
      "call": { "namespace": "profile", "method": "set", "args": { "request": { "customProperties": { "Favorite-Color": "green" } } } },
      "error": { "type": "invalidArgument" }
    },
    {
      "name": "set: ключ customProperties совпадает с полем запроса",
      "call": { "namespace": "profile", "method": "set", "args": { "request": { "customProperties": { "first_name": "Jane" } } } },
      "error": { "type": "invalidArgument" }
    },
    {
      "name": "set: ключ customProperties совпадает со служебным полем",
      "call": { "namespace": "profile", "method": "set", "args": { "request": { "customProperties": { "did": "x" } } } },
      "error": { "type": "invalidArgument" }
    },
