      "expect": { "result": [] }
    },
    {
      "name": "getLastOrder: 400 — неизвестный did",
      "call": { "namespace": "profile", "method": "getLastOrder", "args": {} },
      "response": { "status": 400, "body": { "status": "error", "message": "Client not found" } },
