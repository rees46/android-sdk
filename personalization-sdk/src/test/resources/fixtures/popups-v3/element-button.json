{
  "_fixture": {
    "about": "Элемент button: действия link/close/copy, переменные в ссылке, платформенные ссылки, старый buttonHref, умолчания. Клик по link/copy — событие click, по close — close.",
    "expect": {
      "el-btn-link": {
        "action": "link",
        "spans": [
          {
            "text": "Купить",
            "bold": true
          },
          {
            "text": " со скидкой"
          }
        ],
        "align": "left",
        "bgColor": "#16a34aff",
        "textColor": "#ffffffff",
        "fontSize": 16,
        "radius": 12,
        "paddingX": 24,
        "paddingY": 12,
        "href": {
          "ios": "rees46demo://sale?from=ios",
          "android": "rees46demo://sale?from=android",
          "rule": "ПРЕДЛОЖЕНИЕ, ждёт подтверждения бэка: для {{key}} сначала key_ios / key_android, потом key"
        },
        "event": "click"
      },
      "el-btn-ios-var": {
        "href": "rees46demo://catalog?from=ios_var",
        "note": "обычная переменная: на Android тоже откроется ios_link — так задумано в ТЗ?"
      },
      "el-btn-close": {
        "action": "close",
        "event": "close"
      },
      "el-btn-copy": {
        "action": "copy",
        "clipboard": "SALE10",
        "event": "click"
      },
      "el-btn-copy-fallback": {
        "action": "copy",
        "clipboard": "SALE20",
        "note": "copyText пуст → текст кнопки как есть (вместе с разметкой, как в web)"
      },
      "el-btn-legacy-href": {
        "action": "link",
        "href": "https://demo.rees46.ru"
      },
      "el-btn-defaults": {
        "action": "link",
        "text": "Подробнее (локализованный текст по умолчанию)",
        "align": "center",
        "bgColor": "#2563ebff",
        "textColor": "#ffffffff",
        "fontSize": 14,
        "paddingX": 20,
        "paddingY": 10,
        "radius": 10,
        "href": null,
        "note": "без ссылки нажатие ничего не открывает; событие click всё равно уходит"
      },
      "el-btn-unknown-action": {
        "action": "link",
        "href": "https://demo.rees46.ru"
      }
    }
  },
  "id": 9103,
  "layout": "modal",
  "placement": "center",
  "selector": null,
  "trigger_type": "manual",
  "trigger_value": null,
  "trigger_event": null,
  "frequency": "every_page",
  "cooldown_minutes": 0,
  "promo_code_list_id": null,
  "target_screens": [],
  "design": {
    "frameStyle": {
      "width": 92,
      "height": 320,
      "widthMode": "%",
      "heightMode": "auto",
      "maxWidth": 480,
      "maxWidthMode": "px",
      "bgColor": "#ffffff",
      "borderColor": "#e5e7eb",
