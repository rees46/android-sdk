<?xml version="1.0" encoding="utf-8"?>
<!--
  Текстовые стили дизайн-системы. Применять как android:textAppearance.
  Figma Mobile SDK UI Kit (SSwS49L1fG1psWA7xbakV6), страница Typography.
  Сгенерировано скриптом; правки вносить в источник, не здесь.

  Шрифт: Inter в SDK не поставляется, поэтому используются системные
  начертания — sans-serif (400) и sans-serif-medium (500) как ближайшее
  к Emphasized 600. При переходе на бандл Inter меняется только fontFamily.

  android:letterSpacing задаётся в em и требует API 21,
  android:lineHeight — API 28. На более старых версиях атрибуты
  игнорируются (помечены tools:targetApi, чтобы lint не считал это ошибкой);
  интерлиньяж там ставится из кода через TextViewCompat.setLineHeight
  с dimen personalization_line_height_*.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- XS/Default — 12/16, трекинг 0.05px -->
    <style name="TextAppearance.Personalization.XS.Default" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/personalization_font_size_xs</item>
        <item name="android:lineHeight" tools:targetApi="28">@dimen/personalization_line_height_xs</item>
        <item name="android:letterSpacing" tools:targetApi="21">0.004167</item>
    </style>

    <!-- XS/Emphasized — 12/16, трекинг 0.05px -->
