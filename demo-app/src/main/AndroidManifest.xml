<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ requires this (granted at runtime) for any notification to be shown. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".DemoApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.PersonalizationDemo"
        tools:targetApi="31">

        <!-- Host-provided push icon. FCM uses this to render the small icon when it auto-displays a
             notification-mode push in the background; without it FCM/HMS fall back to the app icon. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_demo_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/demo_notification_color" />

        <!-- singleTask: a link that comes while the demo is open goes to onNewIntent of the same
             activity instead of stacking a second one. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Stories links with the demo scheme, any host and path:
                 rees46://stories?r46_stories=<code>&r46_story=<id>[&r46_slide=<id>] and the links the
                 demo shares (rees46://demo.rees46.ru/?r46_stories=…). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="rees46" />
            </intent-filter>
            <!-- Share links of the demo site. No autoVerify (no assetlinks.json on the site): they open
                 the demo once "Open supported links" is turned on in the app settings. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="demo.rees46.ru"
                    android:scheme="https" />
            </intent-filter>
        </activity>
        <activity
            android:name=".HttpLogActivity"
            android:exported="false" />
    </application>

</manifest>

