<?xml version="1.0" encoding="utf-8"?>
<!-- Tabs in the kit's colours: the checked one in the brand colour, the rest secondary text. The
     Bridge theme would resolve colorPrimary to a very light tint, so the two states are spelled out. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/personalization_brand_primary" android:state_checked="true" />
    <item android:color="@color/personalization_text_secondary" />
</selector>
