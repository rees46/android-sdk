<?xml version="1.0" encoding="utf-8"?>
<!-- The Bridge theme resolves colorPrimary to a very light tint, which makes the checked tab
     almost invisible on the light bar. Spell the two states out instead. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/bottom_nav_item_selected" android:state_checked="true" />
    <item android:color="@color/bottom_nav_item_unselected" />
</selector>
