<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      The demo natively supports dark mode. This DayNight base resolves to Light in day and Dark in
      night (there is no -night override forcing Light any more), backed by dark surface colors in
      values-night/colors.xml. Following the system is what actually stops OEM force-dark: MIUI/EMUI
      only invert apps that DON'T handle night themselves, so once the app renders its own dark UI
      they leave it alone. The earlier "always light" trick relied on -night resources to signal
      dark support while still showing light — MIUI ignored that and whited the text out ("milk"),
      which is why we now go genuinely dark. forceDarkAllowed=false keeps the platform from ALSO
      inverting on top of our own dark colors (API 29+, harmless below).
    -->
    <style name="Theme.PersonalizationDemo" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <!--
          Drive body text from resource-qualified colors (values + values-night) instead of the
          DayNight parent. On some OEMs (notably MIUI) the parent resolves text out of sync with the
          app's own resource selection — white text ends up on a light panel ("milk"). Pinning these to
          @color/* that are selected by the SAME night qualifier as the panel backgrounds keeps text and
          background flipping together, so text stays legible whichever mode the device is in.
        -->
        <item name="android:textColorPrimary">@color/body_text_primary</item>
        <item name="android:textColorSecondary">@color/body_text_secondary</item>
    </style>

    <!--
      The mini-game (GameActivity): no action bar — the screen draws its own panel and goes edge to
      edge, making room for the system bars itself.
    -->
    <style name="Theme.PersonalizationDemo.Game">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!--
      The shop's sort sheet: a Material bottom sheet on the kit's modal surface, top corners of the
      kit's modal radius, kept when the sheet is expanded. DayNight, so the sheet and its ripples
      follow the demo's mode. A full-screen window, edge to edge once the code makes the navigation
      bar transparent: the sheet runs under the bar, its content padded above it.
    -->
    <style name="ThemeOverlay.PersonalizationDemo.ShopSheet" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.PersonalizationDemo.ShopSheet</item>
        <item name="android:windowIsFloating">false</item>
        <item name="enableEdgeToEdge">true</item>
    </style>

    <style name="Widget.PersonalizationDemo.ShopSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/personalization_background_modal</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.PersonalizationDemo.ShopSheet</item>
        <item name="shouldRemoveExpandedCorners">false</item>
        <item name="paddingBottomSystemWindowInsets">true</item>
    </style>

    <style name="ShapeAppearanceOverlay.PersonalizationDemo.ShopSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/personalization_radius_modal</item>
        <item name="cornerSizeTopRight">@dimen/personalization_radius_modal</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

</resources>
